#     cp captures/.secrets.env.example captures/.secrets.env
#     chmod 600 captures/.secrets.env
#
# The single source of truth for real credentials is captures/.secrets.env ONLY.

GW=192.0.2.1

# UniFi UI -> Settings -> Control Plane -> Integrations -> Create API Key
UNIFI_API_KEY=

# Optional local-admin fallback:
UNIFI_USER=
UNIFI_PASS=

# Optional: force a site id (auto-detected otherwise; usually "default")
# SITE=default
